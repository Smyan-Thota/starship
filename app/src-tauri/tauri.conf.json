{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starship",
  "version": "0.1.0",
  "identifier": "io.starship.app",
  "build": {
    "frontendDist": "./shell"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Starship",
        "width": 1400,
        "height": 900,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/starship-engine"],
    "resources": {
      "../dist": "dist"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
